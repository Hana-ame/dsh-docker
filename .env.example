# ==============================================================================
# DSH Web 部署配置
# ==============================================================================
# 用法：cp .env.example .env 后按需修改；所有项都有安全默认值。

# ------------------------------------------------------------------------------
# 一、网络暴露（决定谁能访问 Web UI）
# ------------------------------------------------------------------------------

# 1. 宿主机绑定的 IP
#    127.0.0.1 : 仅本机可访问（默认；配 SSH 隧道 `ssh -L 8080:127.0.0.1:8080` 最安全）
#    0.0.0.0   : 局域网/公网可访问 —— 危险，见下方说明后再改
#    ⚠ dsh 的鉴权是「URL 里的 launch token → 换 cookie」，走的是明文 HTTP。
#      绑 0.0.0.0 等于把带 token 的 URL 暴露给同网段任何人（token 会进浏览器
#      历史/日志/Referer）。确实需要 LAN 访问时，请在前面加一层 TLS 反代
#      （nginx/caddy），并让 HOST_BIND 保持 127.0.0.1。
HOST_BIND=127.0.0.1

# 2. 宿主机对外映射的端口号（宿主机端口 → 容器内 3080）
HOST_PORT=8080

# 3. 允许访问的前端 Host 白名单（空格分隔）
#    dsh 内置 Browser-Trust Fence：通过域名或非 localhost IP 访问时，
#    必须在此添加该域名/IP:端口，否则 /api 返回 403 Forbidden。
#    示例: "192.168.1.100:3080 mydomain.com"
EXTRA_TRUSTED_HOSTS=

# ------------------------------------------------------------------------------
# 二、首次启动配置
# ------------------------------------------------------------------------------

# 4. DeepSeek API Key（可选，也可在 Web 界面里配置）
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 三、多开（同机跑多个实例时改这几项，避免容器名/卷/网段冲突）
# ------------------------------------------------------------------------------

# 容器名（compose 不接受空值；多开时设为 dsh-sandbox-b 之类）
DSH_CONTAINER_NAME=dsh-sandbox
# 镜像 tag（多开时若想复用同一镜像，保持一致即可）
DSH_IMAGE=dsh:latest
# 数据/工作区卷名（多开必须不同，否则两个实例共写同一 profile → 抢锁/串数据）
DSH_DATA_VOLUME=dsh_data
DSH_WORKSPACE_VOLUME=dsh_workspace
# 网段与静态 IP（与宿主既有路由冲突时整组改掉，二者必须同网段）
DSH_SUBNET=172.28.0.0/16
DSH_GATEWAY=172.28.0.1
DSH_CONTAINER_IP=172.28.0.10

# ------------------------------------------------------------------------------
# 四、资源限制
# ------------------------------------------------------------------------------
DSH_CPUS=2.0
DSH_MEMORY=4G

# ------------------------------------------------------------------------------
# 五、构建期镜像源与版本（国内默认；海外构建改成官方源）
# ------------------------------------------------------------------------------
# 国内（默认）
DEBIAN_MIRROR=mirrors.ustc.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
# 海外/官方源：
#DEBIAN_MIRROR=deb.debian.org
#NPM_REGISTRY=https://registry.npmjs.org
# dsh 版本必须显式钉住（rc 预发布版本，`@latest`/`*` 匹配不到 rc）
DSH_VERSION=0.2.2-rc.2
NATIVE_ADDON_VERSION=0.1.9

# 构建期拉 Git 插件用的代理（可选；留空=直连）
# ⚠ 代理地址是「构建容器视角」的地址，127.0.0.1 指的是构建容器自己，不是宿主机。
#   宿主代理通常要写 docker bridge 网关（默认 172.17.0.1）或 host.docker.internal。
#HTTP_PROXY=http://172.17.0.1:7890
#HTTPS_PROXY=http://172.17.0.1:7890
#NO_PROXY=localhost,127.0.0.1,.cn

# ------------------------------------------------------------------------------
# 六、容器 DNS（镜像源用国内时，DNS 也建议换国内）
# ------------------------------------------------------------------------------
DSH_DNS_1=1.1.1.1
DSH_DNS_2=8.8.8.8
# 国内：
#DSH_DNS_1=223.5.5.5
#DSH_DNS_2=119.29.29.29
