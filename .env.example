# ==============================================================================
# DSH Web 访问配置 (IP 与 端口)
# ==============================================================================

# 1. 宿主机绑定的 IP 地址
#    - 0.0.0.0 : 允许从局域网或公网访问（默认）
#    - 127.0.0.1 : 仅允许宿主机本机访问（配合 SSH 隧道最安全）
HOST_BIND=0.0.0.0

# 2. 宿主机对外映射的端口号（可随意更改，如 8080、3000、3080）
HOST_PORT=8080

# 3. 允许访问的前端 Host 白名单（以空格分隔）
#    说明：dsh 内置安全防御（Browser-Trust Fence），如果通过域名或非 localhost IP 访问，
#    必须在此处添加该域名或 IP:端口，否则访问 /api 会返回 403 Forbidden。
#    示例: "192.168.1.100:3080 mydomain.com:3080"
EXTRA_TRUSTED_HOSTS=

# 4. DeepSeek API Key（可选，也可在 Web 界面中直接配置）
DEEPSEEK_API_KEY=
